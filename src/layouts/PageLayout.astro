---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const isBlog = Astro.url.pathname.startsWith('/blog');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Personal website of Haikel Fazzani" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Haikel Fazzani</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav class="navbar" aria-label="Main navigation">
      <div class="nav-container">
        <a href="/" class="nav-logo"><img src="/logo.svg" width="26" height="26" alt="" /><span>Haikel Fazzani</span></a>
        <div class="nav-links">
          <a href="/" class="nav-link" aria-current={!isBlog ? 'page' : undefined}>Home</a>
          <a href="/blog" class="nav-link" aria-current={isBlog ? 'page' : undefined}>Blog</a>
          <a href="mailto:haikel.fazzani@gmail.com" class="nav-link">Contact</a>
        </div>
      </div>
    </nav>
    <main id="main-content" class="main-content">
      <slot />
    </main>
    <footer class="footer">
      <p>&copy; {new Date().getFullYear()} Haikel Fazzani</p>
      <a href="mailto:haikel.fazzani@gmail.com">haikel.fazzani@gmail.com</a>
    </footer>
  </body>
</html>
